{
  "expo": {
    "name": "booksphere",
    "slug": "booksphere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "booksphere",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.driftless.booksphere",
      "infoPlist": {
        "NSCameraUsageDescription": "Booksphere uses the camera to scan book covers, title pages, and copyright pages for quick cataloging.",
        "NSMotionUsageDescription": "This app uses motion data for features like camera stabilization to improve scanning performance.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4debc0f-56ed-4c9b-bbfe-3a210d266fce"
      }
    },
    "owner": "becomingthesound"
  }
}
